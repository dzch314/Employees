{
  "name": "employees",
  "version": "0.0.1",
  "homepage": "dzch314.online",
  "description": "Employees status management system for creating employee card, checking and changing employee status.",
  "author": "Dmitry Chernyavsky <dzch314@gmail.com> (https://github.com/dzch314)",
  "license": "ISC",
  "engines": {
    "node": "22.x.x",
    "npm": "10.x.x"
  },
  "main": "/src/index.tsx",
  "scripts": {
    "start:dev:ui": "webpack serve --env port=3000",
    "start:dev:server": "node ./json-server/index.js",
    "start": "concurrently \"npm run start:dev:ui\" \"npm run start:dev:server\"",
    "build:prod": "webpack --env mode=production",
    "build:dev": "webpack --env mode=development",
    "prettier": "npx prettier --write **/*.{ts,tsx,json}",
    "lint:ts": "eslint \"**/*.{ts,tsx}\"",
    "lint:ts:fix": " eslint \"**/*.{ts,tsx}\" --fix",
    "lint:scss": "npx stylelint \"**/*.scss\"",
    "lint:scss:fix": "npx stylelint \"**/*.scss\" --fix",
    "test:unit": "jest --config ./config/jest/jest.config.ts",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 -c ./config/storybook",
    "storybook:build": "storybook build -c ./config/storybook"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "npx prettier --write --list-different",
      "eslint",
      "jest --config ./config/jest/jest.config.ts --bail --findRelatedTests"
    ],
    "**/*.scss": "npx stylelint"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/react-webpack5": "^9.1.2",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "concurrently": "^9.2.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "eslint-plugin-storybook": "^9.1.2",
    "file-loader": "^6.2.0",
    "globals": "^16.3.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-html-reporter": "^4.3.0",
    "json-server": "^0.17.4",
    "lint-staged": "^16.1.5",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "3.6.2",
    "reg-cli": "^0.18.10",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.90.0",
    "sass-loader": "^16.0.5",
    "storybook": "^9.1.2",
    "style-loader": "^4.0.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.1"
  }
}
